{
  "name": "@ghostfail/claubelib",
  "version": "1.3.1",
  "description": "Helper functions and zod schemas for Anthropic products",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
